rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    match /products/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events_promotions/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /product_reviews/{productId}/items/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/prefs/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /crm_favorites/{docId} {
      allow read: if isAdmin();
      allow write: if isSignedIn();
    }

    match /crm_favorites_events/{docId} {
      allow read: if isAdmin();
      allow write: if isSignedIn();
    }

    match /campaigns/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /leads/{docId} {
      allow read, write: if isAdmin();
    }

    match /push_tokens/{docId} {
      allow read: if isAdmin();
      allow write: if isSignedIn();
    }
    
    // Helper functions for role-based access
    function getUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isUserType(type) {
      return isSignedIn() && getUserProfile().userType == type;
    }
    
    function hasStaffRole(role) {
      return isUserType('staff') && getUserProfile().staffRole == role;
    }
    
    function hasPermission(permission) {
      return isSignedIn() && (
        getUserProfile().userType == 'admin' ||
        getUserProfile().permissions.hasAny([permission, 'admin'])
      );
    }
    
    function isKitchenStaff() {
      return hasStaffRole('kitchen') || hasStaffRole('manager') || isAdmin();
    }
    
    function isDriver() {
      return hasStaffRole('driver') || hasStaffRole('manager') || isAdmin();
    }
    
    // Orders collection - kitchen workflow support
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||  // User's own orders
        isKitchenStaff() ||  // Kitchen can see all orders
        isDriver()  // Drivers can see delivery orders
      );
      
allow create: if isSignedIn();
      
      allow update: if isSignedIn() && (
        isAdmin() ||
        isKitchenStaff() ||  // Kitchen can update order status
        isDriver()  // Drivers can update delivery status
      );
      
      allow delete: if isAdmin();
    }
    
    // User profiles - enhanced with roles
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        hasPermission('staff.manage')
      );
      
      allow create: if isSignedIn() && request.auth.uid == userId;
      
      allow update: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        hasPermission('staff.manage')
      );
      
      allow delete: if isAdmin();
    }
    
    // Reservations (coming in next phase)
    match /reservations/{reservationId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isUserType('staff')
      );
      
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }
    
    // Job listings (for job board feature)
    match /jobs/{jobId} {
      allow read: if true;  // Public job board
      allow create: if isSignedIn() && (
        isAdmin() ||
        isUserType('associate') ||
        hasPermission('jobs.post')
      );
      allow update, delete: if isSignedIn() && (
        isAdmin() ||
        resource.data.postedBy == request.auth.uid
      );
    }
    
    // Job applications
    match /job_applications/{applicationId} {
      allow read: if isSignedIn() && (
        resource.data.applicantId == request.auth.uid ||
        isAdmin() ||
        hasPermission('jobs.view_applications')
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.applicantId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }
    
    // Employee schedules
    match /employee_schedules/{scheduleId} {
      allow read: if isSignedIn() && (
        resource.data.employeeId == request.auth.uid ||
        isAdmin() ||
        hasPermission('schedule.manage')
      );
      allow create, update, delete: if isSignedIn() && (
        isAdmin() ||
        hasPermission('schedule.manage')
      );
    }
    
    // Timesheets (for payroll)
    match /timesheets/{timesheetId} {
      allow read: if isSignedIn() && (
        resource.data.employeeId == request.auth.uid ||
        isAdmin() ||
        hasPermission('payroll.manage')
      );
      allow create: if isSignedIn() && isUserType('staff');
      allow update, delete: if isAdmin() || hasPermission('payroll.manage');
    }
  }
